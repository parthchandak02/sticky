# Copy to .env and edit. Every setting has a default; nothing here is machine specific.

# Network
STICKY_HOST=0.0.0.0
STICKY_PORT=8787
# Shared secret. Required on every write endpoint and on device reads when set.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
STICKY_TOKEN=

# Where state, notes, audio and firmware live (default ~/.local/share/sticky)
STICKY_DATA_DIR=

# Short names for machines on the board, e.g. My-MacBook-Pro=laptop,my-vps=vps
STICKY_HOST_LABELS=

# Display timezone for dates and "today"
STICKY_TZ=America/Los_Angeles

# Usage data: ccusage runs on this host over these Claude Code log dirs
STICKY_CCUSAGE_CMD=npx -y ccusage@20.0.50
STICKY_CLAUDE_PROJECTS_DIR=~/.claude/projects
STICKY_USAGE_REFRESH_SECONDS=300

# Voice: speech to text
# whispercpp = local whisper.cpp binary (brew install whisper-cpp / build on Linux)
STICKY_STT_BACKEND=whispercpp
STICKY_WHISPER_BIN=whisper-cli
STICKY_WHISPER_MODEL=~/.local/share/sticky/models/ggml-large-v3-turbo-q5_0.bin
# Comma-separated names and words that whisper and the cleanup step should expect
STICKY_VOCAB=Claude, Claude Code, VPS, Sticky
STICKY_FFMPEG_BIN=ffmpeg

# Voice: cleanup with Claude through the signed-in Claude Code CLI (uses your plan, no API key)
STICKY_CLEANUP_BACKEND=claude-cli
STICKY_CLAUDE_BIN=claude
STICKY_CLEANUP_MODEL=haiku
