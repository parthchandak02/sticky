{% extends "_layout.html.j2" %}
{% block style %}
.ph { position:absolute; left:0; top:0; width:440px; height:480px; image-rendering:pixelated; }
.col { position:absolute; left:472px; right:var(--m); top:26px; bottom:24px; display:flex; flex-direction:column; }
.col .n { font-family:"News",serif; font-size:210px; font-weight:500; line-height:0.82; letter-spacing:-0.05em; font-variation-settings:"opsz" 40; }
.col .u { font-family:"News",serif; font-size:34px; font-style:italic; margin-top:10px; line-height:1.05; }
.col .rule { height:3px; background:var(--ink); margin:20px 0 14px; }
.col .place { font-family:"News",serif; font-size:28px; font-weight:600; line-height:1.1; }
.col .meta { font-size:16px; font-weight:600; color:var(--graphite); margin-top:4px; }
.col .foot { margin-top:auto; display:flex; justify-content:space-between; align-items:center; font-size:16px; font-weight:700; }
{% endblock %}
{% block body %}
<img class="ph" src="../img/photo_half.png" data-tap="photo:next">
<div class="col">
  <div class="n">2</div>
  <div class="u">years ago today</div>
  <div class="rule"></div>
  <div class="place">Ubud, Bali</div>
  <div class="meta">15 November 2024, the rainy week</div>
  <div class="foot"><span>Swipe up for more</span><span class="dots">{% for i in range(deck_len) %}<i class="{{ 'on' if i == deck_idx }}"></i>{% endfor %}</span></div>
</div>
{% endblock %}
