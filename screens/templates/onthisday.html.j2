{% extends "_layout.html.j2" %}
{% block style %}
.ph { position:absolute; left:0; top:0; width:440px; height:480px; image-rendering:pixelated; }
.col { position:absolute; left:472px; right:var(--m); top:26px; bottom:24px; display:flex; flex-direction:column; }
.col .n { font-family:"News",serif; font-size:210px; font-weight:500; line-height:0.82; letter-spacing:-0.05em; font-variation-settings:"opsz" 40; }
.col .u { font-family:"News",serif; font-size:34px; font-style:italic; margin-top:10px; line-height:1.05; }
.col .rule { height:3px; background:var(--ink); margin:20px 0 14px; }
.col .place { font-family:"News",serif; font-size:28px; font-weight:600; line-height:1.1; }
.col .meta { font-family:"News",serif; font-style:italic; font-size:22px; margin-top:4px; }
.col .foot { margin-top:auto; display:flex; justify-content:space-between; align-items:center; font-size:16px; font-weight:600; color:var(--graphite); border-top:1.5px solid var(--pencil); padding-top:10px; }
{% endblock %}
{% block body %}
<img class="ph" src="{{ d.memory.half }}" data-tap="photo:next">
<div class="col">
  <div class="n">{{ d.memory.years }}</div>
  <div class="u">{{ "year" if d.memory.years == 1 else "years" }} ago today</div>
  <div class="rule"></div>
  <div class="place">{{ d.memory.place }}</div>
  {% if d.memory.line %}<div class="meta">{{ d.memory.line }}</div>{% endif %}
  <div class="foot"><span>{{ d.memory.date }}</span><span class="dots">{% for i in range(deck_len) %}<i class="{{ 'on' if i == deck_idx }}"></i>{% endfor %}</span></div>
</div>
{% endblock %}
