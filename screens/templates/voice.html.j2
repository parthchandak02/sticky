{% extends "_layout.html.j2" %}
{% block style %}
/* Listening: the level history is the feedback; the device redraws it with a partial refresh about once a second. */
.go { position:absolute; left:var(--m); top:58px; font-family:"News",serif; font-size:76px; font-weight:500; line-height:1; letter-spacing:-0.02em; }
.go em { font-style:italic; font-weight:400; }
.levels { position:absolute; left:var(--m); right:var(--m); top:168px; height:150px; display:flex; align-items:center; gap:5px; border-top:2px solid var(--ink); border-bottom:2px solid var(--ink); }
.levels i { flex:1; background:var(--ink); border-radius:1px; }
.levels i.q { background:var(--pencil); }
.modes { position:absolute; left:var(--m); right:var(--m); bottom:24px; display:grid; grid-template-columns:repeat(3,1fr); gap:var(--g); }
.modes div { font-size:16px; font-weight:600; color:var(--graphite); }
.modes b { display:block; font-family:"News",serif; font-size:28px; color:var(--ink); font-weight:600; line-height:1.1; }
.modes div { border-top:2px solid var(--ink); padding-top:8px; }
.modes .on { border-top:8px solid var(--ink); padding-top:2px; }
.modes div i { font-family:"News",serif; font-size:19px; color:var(--ink); }
.secs { position:absolute; right:var(--m); top:64px; font-family:"News",serif; font-size:60px; font-weight:500; line-height:1; text-align:right; }
.secs span { display:block; font-family:"Sans"; font-size:16px; font-weight:700; margin-top:4px; }

/* Result */
.kicker { position:absolute; left:var(--m); top:58px; font-family:"News",serif; font-style:italic; font-size:24px; }
.vt { position:absolute; left:var(--m); top:94px; width:500px; font-family:"News",serif; font-size:50px; font-weight:600; line-height:1.02; letter-spacing:-0.02em; }
.facts { position:absolute; left:var(--m); width:470px; bottom:22px; }
.facts .r { display:grid; grid-template-columns:96px 1fr; padding:10px 0 9px; border-top:1.5px solid var(--pencil); font-size:18px; font-weight:600; }
.facts .r:first-child { border-top:2px solid var(--ink); }
.facts .r span { color:var(--ink); font-weight:700; font-size:16px; }
.heard { position:absolute; left:528px; right:var(--m); top:58px; bottom:22px; display:flex; flex-direction:column; border-left:2px solid var(--ink); padding-left:18px; }
.heard .h { font-family:"News",serif; font-style:italic; font-size:22px; }
.heard p { font-family:"News",serif; font-style:italic; font-size:21px; line-height:1.3; margin-top:8px; color:var(--ink); }
.acts { position:absolute; left:548px; right:var(--m); top:250px; display:flex; gap:10px; }
.acts .btn { flex:1; }
.acts .btn { height:48px; }
{% endblock %}
{% block body %}
{% set v = d.voice %}
{% if mode == 'listening' %}
<div class="go"><em>Listening</em></div>
<div class="secs">0:07<span>let go to send</span></div>
<div class="levels">{% for h in [10,18,30,52,84,70,40,78,96,60,34,16,46,80,64,26,12,10,34,72,88,50,24,10,8,20,44,66,90,58,30,14,38,74,92,62,28,12,22,48,70,36] %}<i style="height:{{ h }}px"></i>{% endfor %}</div>
<div class="modes">
  <div class="on"><b>Note</b><i>just talk</i></div>
  <div><b>Task</b><i>say &ldquo;task&rdquo; first</i></div>
  <div><b>Ask Claude</b><i>say &ldquo;ask&rdquo; first</i></div>
</div>
{% else %}
<div class="kicker">{{ v.kind }}</div>
<div class="vt">{{ v.title }}</div>
<div class="facts">
  <div class="r"><span>Company</span>Avis</div>
  <div class="r"><span>Drivers</span>Both of us</div>
  <div class="r"><span>Pick up</span>12 Dec, at the airport</div>
  <div class="r"><span>Due</span>1 Dec</div>
</div>
<div class="heard"><div class="h">What I heard</div><p>&ldquo;{{ v.heard }}&rdquo;</p></div>
<div class="acts">
  <div class="btn line" data-tap="undo">Undo</div>
  <div class="btn dark" data-tap="done">Done</div>
</div>
{% endif %}
{% endblock %}
