{% extends "_layout.html.j2" %}
{% block style %}
.back { position:absolute; left:0; top:0; width:200px; height:44px; }
.main { position:absolute; left:var(--m); top:62px; width:440px; }
.proj { font-family:"News",serif; font-size:64px; font-weight:600; line-height:0.95; letter-spacing:-0.02em; }
.wants { font-family:"News",serif; font-style:italic; font-size:26px; color:var(--ink); margin-top:6px; }
.cmdbox { margin-top:20px; position:relative; }
.cmdbox .shadow { position:absolute; left:8px; top:8px; right:-8px; bottom:-8px; }
.cmdbox .inner { position:relative; background:var(--paper); border:3px solid var(--ink); padding:14px 16px; }
.cmdbox .tool { font-size:15px; font-weight:700; display:flex; justify-content:space-between; }
.cmdbox .tool .graphite { font-weight:600; color:var(--ink); }
.cmdbox code { display:block; font-family:"Code"; font-size:26px; margin-top:6px; line-height:1.25; }
.facts { display:flex; gap:40px; margin-top:30px; border-top:2px solid var(--ink); padding-top:10px; }
.facts div { font-size:15px; font-weight:600; color:var(--graphite); }
.facts b { display:block; font-family:"News",serif; font-size:26px; color:var(--ink); font-weight:600; margin-top:1px; }

.side { position:absolute; right:var(--m); top:62px; width:250px; bottom:22px; display:flex; flex-direction:column; align-items:center; }
.dial { width:220px; height:220px; position:relative; display:grid; place-items:center; }
.dial svg { position:absolute; inset:0; }
.dial .face { width:168px; height:168px; border-radius:50%; background:var(--ink); color:var(--paper); display:flex; flex-direction:column; align-items:center; justify-content:center; }
.dial .face b { font-family:"News",serif; font-size:46px; font-weight:500; line-height:1; }
.dial .face span { font-size:18px; font-weight:700; margin-top:4px; }
.deny { margin-top:auto; width:220px; height:52px; }
.side .answer { font-family:"News",serif; font-style:italic; font-size:28px; line-height:1.15; }
.done .face { background:var(--paper); color:var(--ink); border:3px solid var(--ink); }
{% endblock %}
{% block body %}
{% set s = (d.sessions|selectattr('state','equalto','waiting')|first) or d.sessions[0] %}
<div class="back" data-tap="back"></div>
<section class="main">
  <div class="proj">{{ s.project }}</div>
  <div class="wants">wants to run</div>
  <div class="cmdbox">
    <div class="inner"><div class="tool"><span>{{ s.tool }}</span><span class="graphite">{{ s.where }}</span></div><code>{{ s.command }}</code></div>
  </div>
  <div class="facts">
    <div>Machine<b>{{ s.host }}</b></div>
    <div>Asked<b>{{ s.asked or (s.ago ~ " ago") }}</b></div>
    <div>Session<b>{{ s.age }}</b></div>
  </div>
</section>
{% if s.approvable is not defined or s.approvable %}<section class="side">
  {% set p = progress|default(0) %}
  <div class="dial {{ 'done' if p >= 24 }}" data-hold="allow:{{ s.id }}">
    <svg viewBox="0 0 236 236" width="220" height="220">
      {% set C = 2 * 3.14159 * 106 %}
      <circle cx="118" cy="118" r="106" fill="none" stroke="#000" stroke-width="2.5"/>
      {% if p > 0 %}<circle cx="118" cy="118" r="106" fill="none" stroke="#000" stroke-width="14" stroke-dasharray="{{ C * p / 24 }} {{ C }}" transform="rotate(-90 118 118)"/>{% endif %}
    </svg>
    <div class="face">{% if p >= 24 %}<b>Allowed</b>{% else %}<b>Hold</b><span>to allow</span>{% endif %}</div>
  </div>
  <div class="btn line deny" data-tap="deny:{{ s.id }}">Deny</div>
</section>{% else %}<section class="side"><div class="answer">Answer this one in the terminal on {{ s.host }}.</div><div class="btn line deny" data-tap="back">Back</div></section>{% endif %}
{% endblock %}
