{% extends "_layout.html.j2" %}
{% block style %}
.big { position:absolute; left:20px; top:58px; font-family:"News",serif; font-weight:500; font-size:290px; line-height:1; letter-spacing:-0.06em; font-variation-settings:"opsz" 40; }
.what { position:absolute; left:var(--m); top:310px; font-family:"News",serif; font-style:italic; font-size:34px; font-weight:400; }
.what span { display:block; font-family:"Sans"; font-style:normal; font-size:16px; font-weight:600; color:var(--graphite); margin-top:6px; }
.cal { position:absolute; right:var(--m); top:62px; width:310px; }
.cal .m { font-family:"News",serif; font-size:26px; font-weight:600; display:flex; justify-content:space-between; align-items:baseline; border-bottom:2px solid var(--ink); padding-bottom:6px; }
.cal .m span { font-family:"Sans"; font-size:13px; color:var(--graphite); font-weight:600; }
.grid { display:grid; grid-template-columns:repeat(7, 1fr); margin-top:8px; row-gap:2px; }
.grid .h { font-family:"News",serif; font-style:italic; font-size:18px; font-weight:500; color:var(--ink); text-align:center; padding-bottom:4px; }
.grid .c { height:46px; display:grid; place-items:center; font-family:"News",serif; font-size:19px; font-weight:500; position:relative; }
.grid .c.we { color:var(--ink); font-style:italic; }
.grid .c.hit { font-weight:700; color:var(--paper); z-index:1; }
.grid .c.hit::before { content:""; position:absolute; left:50%; top:50%; width:34px; height:34px; margin:-17px 0 0 -17px; background:var(--ink); border-radius:50%; z-index:-1; }
.grid .c.hit svg { position:absolute; left:-6px; top:-7px; }
.soon { position:absolute; left:var(--m); width:400px; bottom:20px; display:grid; grid-template-columns:1fr 1fr; gap:24px; }
.soon .r { padding:9px 0 0; border-top:2px solid var(--ink); }
.soon .t { display:flex; flex-direction:column; }
.soon .t b { font-size:17px; font-weight:700; }
.soon .t span { font-family:"News",serif; font-size:30px; font-weight:600; order:2; line-height:1.1; }
.soon .t span i { font-size:18px; font-style:italic; font-weight:400; margin-left:3px; }
.soon .bar { height:6px; margin-top:6px; background:var(--pencil); position:relative; }
.soon .bar i { position:absolute; left:0; top:0; bottom:0; background:var(--ink); }
{% endblock %}
{% block body %}
{% set c = d.countdown %}
<div class="big">{{ c.days }}</div>
<div class="what">{{ c.what }}</div>
<div class="cal">
  <div class="m">{{ c.month }}</div>
  <div class="grid">
    {% for h in ['M','T','W','T','F','S','S'] %}<div class="h">{{ h }}</div>{% endfor %}
    {% for i in range(c.first_weekday) %}<div class="c"></div>{% endfor %}
    {% for day in range(1, c.month_days + 1) %}
      {% set wd = (c.first_weekday + day - 1) % 7 %}
      <div class="c {{ 'we' if wd >= 5 }} {{ 'hit' if day == c.day }}">{{ day }}
      </div>
    {% endfor %}
  </div>
</div>
<div class="soon">
  {% for n in c.next %}
  <div class="r"><div class="t"><b>{{ n.name }}</b><span>{{ n.days }}<i>days</i></span></div>
  </div>
  {% endfor %}
</div>
{% endblock %}
