{% extends "_layout.html.j2" %}
{% block style %}
canvas { position:absolute; inset:0; }
.cap { position:absolute; right:var(--m); bottom:22px; text-align:right; }
.cap .a { font-family:"News",serif; font-style:italic; font-size:40px; font-weight:500; line-height:1; }
.cap .b { font-size:16px; font-weight:700; color:var(--graphite); margin-top:6px; }
.credit { position:absolute; left:var(--m); bottom:22px; font-size:15px; font-weight:700; color:var(--graphite); }
.credit b { display:block; color:var(--ink); font-family:"News",serif; font-size:24px; font-weight:600; }
{% endblock %}
{% block body %}
<canvas id="c" width="800" height="480"></canvas>
<div class="credit"><b>Lorenz, today</b>From today's crypto prices</div>
<div class="cap"><div class="a">Asleep</div><div class="b">Wakes at 6:30</div></div>
<script>
// Lorenz attractor, deterministic. Thin ink strokes build up into the panel's grays.
const c = document.getElementById('c').getContext('2d');
c.fillStyle = '#fff'; c.fillRect(0, 0, 800, 480);
const runs = [[-6.2, 3.1, 30.5, 1]];
for (const [x0, y0, z0, alpha] of runs) {
  let x = x0, y = y0, z = z0;
  const s = 10, r = 28, b = 8 / 3, dt = 0.0035;
  c.strokeStyle = `rgba(0,0,0,${alpha})`; c.lineWidth = 1.35;
  c.beginPath();
  for (let i = 0; i < 9000; i++) {
    const dx = s * (y - x), dy = x * (r - z) - y, dz = x * y - b * z;
    x += dx * dt; y += dy * dt; z += dz * dt;
    const px = 400 + x * 12.2, py = 418 - z * 7.4;
    if (i < 200) { c.moveTo(px, py); continue; }
    c.lineTo(px, py);
    if (i % 400 === 0) { c.stroke(); c.beginPath(); c.moveTo(px, py); }
  }
  c.stroke();
}
</script>
{% endblock %}
