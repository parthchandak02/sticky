{% extends "_layout.html.j2" %}
{% block style %}
canvas { position:absolute; inset:0; }
.cap { position:absolute; right:var(--m); bottom:22px; text-align:right; }
.cap .a { font-family:"News",serif; font-style:italic; font-size:34px; font-weight:500; line-height:1; }
.cap .b { font-size:13px; font-weight:700; color:var(--graphite); margin-top:6px; }
.title { position:absolute; left:var(--m); bottom:22px; font-size:13px; font-weight:700; color:var(--graphite); }
.title b { display:block; color:var(--ink); font-family:"News",serif; font-size:19px; font-weight:600; }
{% endblock %}
{% block body %}
<canvas id="c" width="800" height="480"></canvas>
<div class="title"><b>Strange attractor</b>From trace, today's market swings</div>
<div class="cap"><div class="a">Asleep</div><div class="b">Wakes at 6:30</div></div>
<script>
// Lorenz attractor, deterministic. Thin ink strokes build up into the panel's grays.
const c = document.getElementById('c').getContext('2d');
c.fillStyle = '#fff'; c.fillRect(0, 0, 800, 480);
const runs = [[0.1, 0, 0, 0.2], [0.12, 0.02, 0.01, 0.12]];
for (const [x0, y0, z0, alpha] of runs) {
  let x = x0, y = y0, z = z0;
  const s = 10, r = 28, b = 8 / 3, dt = 0.0035;
  c.strokeStyle = `rgba(0,0,0,${alpha})`; c.lineWidth = 1.1;
  c.beginPath();
  for (let i = 0; i < 52000; i++) {
    const dx = s * (y - x), dy = x * (r - z) - y, dz = x * y - b * z;
    x += dx * dt; y += dy * dt; z += dz * dt;
    const px = 400 + x * 13.5, py = 448 - z * 8.4;
    if (i === 0) c.moveTo(px, py); else c.lineTo(px, py);
    if (i % 400 === 0) { c.stroke(); c.beginPath(); c.moveTo(px, py); }
  }
  c.stroke();
}
</script>
{% endblock %}
