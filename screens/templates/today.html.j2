{% extends "_layout.html.j2" %}
{% block style %}
.mast { position:absolute; left:var(--m); top:52px; }
.mast .day { font-family:"News",serif; font-size:88px; font-weight:600; line-height:0.9; letter-spacing:-0.03em; }
.mast .date { font-family:"News",serif; font-style:italic; font-size:30px; margin-top:6px; }
.wx { position:absolute; right:var(--m); top:56px; display:flex; gap:16px; align-items:flex-start; }
.wx .t { font-family:"News",serif; font-size:84px; font-weight:500; line-height:0.85; letter-spacing:-0.03em; }
.wx .t sup { font-size:40px; vertical-align:top; }
.wx .info { font-size:15px; font-weight:600; color:var(--graphite); line-height:1.5; margin-top:2px; }
.wx .info b { color:var(--ink); font-size:18px; display:block; }

.line { position:absolute; left:var(--m); right:var(--m); top:196px; height:104px; }
.line .axis { position:absolute; left:0; right:0; top:62px; height:2px; background:var(--ink); }
.line .past { position:absolute; left:0; top:40px; height:44px; }
.ev { position:absolute; top:40px; height:44px; border:2px solid var(--ink); background:var(--paper); }
.lab { position:absolute; top:12px; font-size:15px; font-weight:700; white-space:nowrap; }
.lab.done { color:var(--graphite); }
.ev.done { border-color:var(--graphite); background:var(--paper); }

.ev.next { background:var(--ink); color:var(--paper); }

.hr { position:absolute; top:92px; font-size:14px; font-weight:700; color:var(--ink); transform:translateX(-50%); }
.tick { position:absolute; top:86px; width:1.5px; height:5px; background:var(--ink); }
.now { position:absolute; top:30px; bottom:18px; width:3px; background:var(--ink); }
.now::before { content:""; position:absolute; left:-6px; top:-6px; border:7.5px solid transparent; border-top:9px solid var(--ink); }

.upnext { position:absolute; left:var(--m); right:var(--m); top:330px; display:grid; grid-template-columns:1.25fr 1fr 1fr; gap:var(--g); }
.card { border-top:2px solid var(--ink); padding-top:10px; }
.card .when { font-family:"News",serif; font-size:40px; font-weight:500; line-height:1; letter-spacing:-0.02em; }
.card .when i { font-size:20px; font-style:italic; margin-left:4px; }
.card .what { font-size:18px; font-weight:700; margin-top:6px; }
.card .sub { font-size:15px; font-weight:600; color:var(--graphite); margin-top:2px; }
.room { position:absolute; left:var(--m); right:var(--m); bottom:16px; display:flex; justify-content:space-between; font-size:13px; font-weight:600; color:var(--graphite); border-top:1px solid var(--pencil); padding-top:8px; }
.room b { color:var(--ink); }
{% endblock %}
{% block body %}
{% set t = d.today %}
<div class="mast"><div class="day">{{ t.day }}</div><div class="date">{{ t.date }}</div></div>
<div class="wx">
  <div class="t">{{ t.temp }}<sup>°</sup></div>
  <div class="info"><b>{{ t.sky }}</b>High {{ t.hi }}°, low {{ t.lo }}°<br>Inside {{ t.inside }}, {{ t.humidity }}</div>
</div>

{% set h0, h1 = 7, 23 %}
{% macro x(h) %}{{ ((h - h0) / (h1 - h0) * 752)|round(1) }}{% endmacro %}
<div class="line">
  <div class="axis"></div>
  {% set nxt = t.events|selectattr('end','gt',t.now_h)|first %}
  {% for e in t.events %}
    {% set state = 'done' if e.end <= t.now_h else ('next' if e == nxt else '') %}
    <div class="ev {{ state }}" style="left:{{ x(e.start) }}px;width:{{ ((e.end - e.start) / (h1 - h0) * 752)|round(1) }}px"></div><div class="lab {{ state }}" style="left:{{ x(e.start) }}px">{{ e.title.split(",")[0] if state != "done" else e.title.split(" ")[0].split(",")[0] }}</div>
  {% endfor %}
  {% for hh in range(h0, h1 + 1) %}<div class="tick" style="left:{{ x(hh) }}px"></div>{% if hh % 3 == 1 %}<div class="hr" style="left:{{ x(hh) }}px">{{ hh }}</div>{% endif %}{% endfor %}
  <div class="now" style="left:{{ x(t.now_h) }}px"></div>
</div>

<div class="upnext">
  {% set upcoming = t.events|selectattr('end','gt',t.now_h)|list %}
  {% for e in upcoming[:1] %}
  <div class="card" data-tap="event:{{ loop.index0 }}"><div class="when">{{ e.time }}<i>in 1h 7m</i></div><div class="what">{{ e.title }}</div><div class="sub">Home</div></div>
  {% endfor %}
  <div class="card"><div class="when">Mon<i>9:30</i></div><div class="what">Dentist</div><div class="sub">Market St</div></div>
  <div class="card"><div class="when">Tue<i>all day</i></div><div class="what">Jobwright launch</div><div class="sub">3 tasks left</div></div>
</div>
{% endblock %}
