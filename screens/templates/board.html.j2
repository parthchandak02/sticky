{% extends "_layout.html.j2" %}
{% block style %}
.left { position:absolute; left:var(--m); top:54px; width:268px; bottom:16px; display:flex; flex-direction:column; }
.spend-label { font-size:15px; font-weight:700; }
.spend { font-family:"News",serif; font-weight:500; font-size:92px; line-height:0.9; letter-spacing:-0.035em; margin-top:2px; }
.spend sup { font-size:44px; vertical-align:top; position:relative; top:22px; margin-right:2px; letter-spacing:0; }
.spend small { font-size:52px; }
.periods { display:flex; gap:22px; margin-top:6px; font-size:15px; font-weight:600; }
.periods b { color:var(--ink); font-family:"News",serif; font-size:21px; font-weight:600; margin-left:4px; }

.meter { margin-top:14px; }
.meter .top { display:flex; align-items:baseline; justify-content:space-between; }
.meter .name { font-size:16px; font-weight:700; }
.meter .name span { font-weight:600; color:var(--ink); margin-left:6px; font-size:15px; }
.meter .pct { font-family:"News",serif; font-size:30px; font-weight:500; line-height:1; letter-spacing:-0.02em; }
.meter .pct i { font-size:17px; font-style:normal; margin-left:1px; }
.track { position:relative; height:12px; margin-top:7px; }
.track .fill { position:absolute; left:0; top:0; bottom:0; background:var(--ink); }
.track .rest { position:absolute; top:0; bottom:0; right:0; background:var(--pencil); }
.ticks { display:flex; justify-content:space-between; height:5px; margin-top:3px; }
.ticks i { width:1.5px; background:var(--ink); }
.ticks i:nth-child(odd) { height:5px; } .ticks i:nth-child(even) { height:3px; background:var(--graphite); }


.chart { margin-top:auto; border-top:2px solid var(--ink); padding-top:26px; }
.chart .bars { display:flex; align-items:flex-end; gap:5px; height:58px; margin-top:0; border-bottom:2px solid var(--ink); }
.chart .bars i { flex:1; background:var(--graphite); display:block; }
.chart .bars i.today { background:var(--ink); }
.chart .axis { display:flex; justify-content:space-between; font-size:14px; font-weight:600; margin-top:5px; }
.chart .axis b { font-weight:700; }
.chart { position:relative; }
.chart .peak { position:absolute; left:0; right:0; border-top:1.5px dashed var(--graphite); }
.chart .peak span { position:absolute; right:0; top:-21px; font-size:14px; font-weight:700; background:var(--paper); padding-left:6px; }

.split { position:absolute; left:316px; top:58px; bottom:16px; width:2px; background:var(--ink); }

.right { position:absolute; left:336px; right:var(--m); top:52px; bottom:16px; display:flex; flex-direction:column; }
.headline { font-family:"News",serif; font-size:23px; font-weight:500; display:flex; justify-content:space-between; align-items:baseline; }
.headline em { font-style:italic; }


.ask { margin-top:8px; background:var(--ink); color:var(--paper); border-radius:3px; padding:14px 16px 14px; position:relative; }
.ask .who { display:flex; align-items:baseline; justify-content:space-between; }
.ask .proj { font-family:"News",serif; font-size:30px; font-weight:600; line-height:1; letter-spacing:-0.01em; }
.ask .host { font-size:15px; font-weight:600; }
.ask .cmd { margin-top:10px; font-family:"Code"; font-size:15px; line-height:1.35; padding:8px 10px; background:var(--paper); color:var(--ink); border-radius:3px; }
.ask .cmd .tool { font-family:"Sans"; font-weight:700; font-size:14px; color:var(--graphite); display:block; margin-bottom:2px; }
.ask .answer { margin-top:12px; font-size:16px; font-weight:700; }
.ask .acts { display:flex; gap:10px; margin-top:12px; }
.ask .acts .btn { height:48px; }
.ask .acts .hold { flex:1; }
.ask .acts .hold svg { margin-right:2px; }

.rows { margin-top:6px; }
.toast { left:556px; }
.row { display:grid; grid-template-columns:26px 1fr auto; column-gap:10px; align-items:center; padding:9px 0 8px; border-bottom:1px solid var(--pencil); }
.row:last-child { border-bottom:none; }
.glyph { width:14px; height:14px; justify-self:center; }
.glyph.working { background:var(--ink); }
.glyph.idle { border:2.5px solid var(--ink); }
.glyph.idle { border:2px solid var(--ink); }
.glyph.done { border-radius:0; background:none; }
.row .name { font-family:"News",serif; font-size:22px; font-weight:600; line-height:1.05; }
.row .what { font-size:15px; color:var(--ink); font-weight:600; margin-top:1px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:300px; }
.row .meta { font-size:15px; font-weight:700; text-align:right; }
.row .meta span { display:block; color:var(--ink); font-weight:600; }
{% endblock %}
{% block body %}
{% set u = d.usage %}
<section class="left">
  <div class="spend-label">Spent today</div>
  <div class="spend"><sup>$</sup>{{ u.today.split('.')[0] }}<small>.{{ u.today.split('.')[1] }}</small></div>
  <div class="periods"><div>Week<b>${{ u.week }}</b></div><div>Month<b>${{ u.month }}</b></div></div>

  {% for m in u.limits %}
  <div class="meter">
    <div class="top"><div class="name">{{ m.name }}<span>{{ m.reset }}</span></div><div class="pct">{{ m.pct }}<i>%</i></div></div>
    <div class="track"><div class="fill" style="width:{{ m.pct }}%"></div><div class="rest" style="width:{{ 100 - m.pct }}%"></div></div>
  </div>
  {% endfor %}

  <div class="chart">
    {% if u.days|max > 0 %}<div class="peak" style="top:26px"><span>${{ "%.2f"|format(u.days|max) }}</span></div>{% endif %}
    {% set top = [u.days|max, 0.01]|max %}<div class="bars">{% for v in u.days %}<i class="{{ 'today' if loop.last }}" style="height:{{ [(v / top * 100)|round|int, 2]|max }}%"></i>{% endfor %}</div>
    <div class="axis"><span>Last 14 days</span><b>Today</b></div>
  </div>
</section>
<div class="split"></div>

<section class="right">
  {% set waiting = d.sessions|selectattr('state','equalto','waiting')|list %}
  {% set working = d.sessions|selectattr('state','equalto','working')|list %}
  <div class="headline">
    {% if waiting %}<div><em>{{ waiting|length }} needs you</em>, {{ working|length }} working</div>
    {% else %}<div><em>All clear</em>, {{ working|length }} working</div>{% endif %}
  </div>

  {% for s in waiting[:1] %}
  <div class="ask" data-tap="open:approve">
    <div class="who"><div class="proj">{{ s.project }}</div><div class="host">{{ s.host }} · {{ s.ago }}</div></div>
    <div class="cmd"><span class="tool">{{ s.tool }}</span>{{ s.command }}</div>
    {% if s.approvable is not defined or s.approvable %}
    <div class="acts">
      <div class="btn ghost" data-tap="deny:{{ s.id }}">Deny</div>
      <div class="btn fill hold" data-hold="allow:{{ s.id }}">
        Hold to allow
      </div>
    {% else %}<div class="answer">Answer in the terminal on {{ s.host }}</div>{% endif %}
    </div>
  </div>
  {% endfor %}

  <div class="rows">
  {% for s in d.sessions if s.state != 'waiting' %}{% if loop.index <= (3 if waiting else 5) %}
    <div class="row" data-tap="session:{{ s.id }}">
      {% if s.state == 'done' %}
      <svg class="glyph done" viewBox="0 0 16 16"><path d="M2 8.5l4 4 8-9" fill="none" stroke="#000" stroke-width="2.6"/></svg>
      {% else %}<div class="glyph {{ s.state }}"></div>{% endif %}
      <div><div class="name">{{ s.project }}</div><div class="what">{{ s.doing }}</div></div>
      <div class="meta">{{ s.host }}<span>{{ s.ago }}</span></div>
    </div>
  {% endif %}{% endfor %}
  </div>
</section>
{% if toast %}<div class="toast"><span class="ok"><svg width="14" height="14" viewBox="0 0 16 16"><path d="M2 8.5l4 4 8-9" fill="none" stroke="#000" stroke-width="2.8"/></svg></span>{{ toast }}</div>{% endif %}
{% endblock %}
